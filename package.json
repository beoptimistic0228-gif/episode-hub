{
  "name": "episode-hub",
  "version": "0.2.0",
  "description": "Episode Hub — 누구의 공간 산출물 에피소드별 관리 데스크톱 앱",
  "author": "nakgwan",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.nakgwan.episode-hub",
    "productName": "Episode Hub",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Episode Hub",
      "artifactName": "EpisodeHub-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "beoptimistic0228-gif",
      "repo": "episode-hub",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^3.6.0",
    "dompurify": "^3.4.11",
    "marked": "^12.0.0",
    "recharts": "^2.15.4",
    "zod": "^4.4.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vitest": "^2.0.5"
  }
}
